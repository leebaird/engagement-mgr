{
  "name": "engagement-mgr",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "predev": "prisma generate",
    "dev": "node scripts/run-next.mjs dev",
    "build": "prisma generate && next build",
    "start": "node scripts/run-next.mjs start",
    "test": "node --import tsx --test --experimental-test-isolation=none \"src/**/*.test.ts\"",
    "test:reporting": "node --import tsx --test --experimental-test-isolation=none tests/reporting.integration.ts",
    "test:browser": "playwright test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "rm -rf .next/types .next/dev/types && tsc --noEmit",
    "audit": "npm audit",
    "db:migrate": "prisma migrate deploy",
    "db:restore": "node --import tsx scripts/restore-backup.ts",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "fast-xml-parser": "5.11.1",
    "jose": "6.2.10",
    "lucide-react": "1.39.0",
    "marked": "18.0.11",
    "next": "16.3.4",
    "pdfkit": "0.20.2",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.1",
    "@types/pdfkit": "0.17.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "oxlint": "1.81.0",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "overrides": {
    "postcss": "8.5.25",
    "@hono/node-server": "2.0.12",
    "nanoid": "3.3.18",
    "deepmerge-ts": "8.0.1",
    "mysql2": "3.24.3"
  }
}
