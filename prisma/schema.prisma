generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String        @id @default(uuid())
  username             String        @unique
  passwordHash         String
  role                 Role          @default(User)
  lastPasswordChange   DateTime      @default(now())
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  lastLogin            DateTime?
}

enum Role {
  Admin
  User
}

model Engagement {
  id                   String        @id @default(uuid())
  codeName             String
  clientId             String
  client               Client        @relation(fields: [clientId], references: [id])
  chargeCode           String?
  status               EngagementStatus?
  focus                String?
  type                 EngagementType?
  location             Location?
  objectives           String?
  targets              String?
  exclusions           String?
  notes                String?
  startPlanning        DateTime?
  endPlanning          DateTime?
  startPrep            DateTime?
  endPrep              DateTime?
  startTesting         DateTime?
  endTesting           DateTime?
  startReporting       DateTime?
  endReporting         DateTime?
  outbrief             DateTime?
  operators            Operator[]    // Implicit M:N
  contacts             Contact[]     @relation("EngagementContacts")
  trustedAgents        Contact[]     @relation("TrustedAgents")
  findings             Finding[]
  findingContexts      EngagementFindingContext[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

enum EngagementStatus {
  Planning
  Prep
  Testing
  Reporting
  Complete
}

enum EngagementType {
  AI
  Code_Review
  Firewall
  Multi
  Pentest
  Phishing
  Physical
  Purple_Team
  Red_Team
  USB_Drop
  Vishing
  Web_App
  Wireless
}

enum Location {
  Internal
  External
}

model Client {
  id                   String        @id @default(uuid())
  company              String        @map("companyName")
  address              String?
  city                 String?
  state                String?
  zip                  String?
  phone                String?       @map("phoneNumber")
  website              String?
  notes                String?
  contacts             Contact[]
  engagements          Engagement[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model Contact {
  id                   String        @id @default(uuid())
  clientId             String
  client               Client        @relation(fields: [clientId], references: [id])
  name                 String
  title                String?
  email                String?
  phone                String?       @map("phoneNumber")
  notes                String?
  assignedEngagements  Engagement[]  @relation("EngagementContacts")
  trustedEngagements   Engagement[]  @relation("TrustedAgents")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model Finding {
  id                   String        @id @default(uuid())
  engagementId         String?
  engagement           Engagement?   @relation(fields: [engagementId], references: [id])
  title                String
  category             String?
  severity             String
  background           String?
  remediation          String?
  supportingData       String?       @map("supportingLinks")
  screenshots          Screenshot[]
  engagementContext    EngagementFindingContext?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model EngagementFindingContext {
  id             String     @id @default(uuid())
  engagementId   String
  findingId      String     @unique
  engagement     Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  finding        Finding    @relation(fields: [findingId], references: [id], onDelete: Cascade)
  observation    String?
  affectedHosts  String?    @map("affected_hosts")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([engagementId, findingId])
}

model Screenshot {
  id                   String        @id @default(uuid())
  findingId            String   
  finding              Finding       @relation(fields: [findingId], references: [id])
  filePath             String
  description          String?
  createdAt            DateTime      @default(now())
}

model Operator {
  id                   String        @id @default(uuid())
  name                 String
  title                String?
  email                String?
  phoneNumber          String?
  discord              String?
  github               String?
  notes                String?
  engagements          Engagement[]  // Implicit M:N
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}
