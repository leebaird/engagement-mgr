generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String        @id @default(uuid())
  username             String        @unique
  passwordHash         String
  role                 Role          @default(User)
  lastPasswordChange   DateTime      @default(now())
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  lastLogin            DateTime?
  authoredFindings     Finding[] @relation("FindingAuthor")
  assignedReviews      Finding[] @relation("FindingReviewer")
  findingDrafts        FindingDraft[]
}

model LoginRateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

enum Role {
  Admin
  User
}

model ApplicationSetting {
  id             Int            @id @default(1)
  highlightColor HighlightColor @default(Pink)
  updatedAt      DateTime       @updatedAt
}

enum HighlightColor {
  Pink
  Blue
  Teal
  Green
  Purple
  Amber
}

model Engagement {
  id                   String        @id @default(uuid())
  codeName             String
  clientId             String
  client               Client        @relation(fields: [clientId], references: [id])
  chargeCode           String?
  status               EngagementStatus?
  focus                String?
  type                 EngagementType?
  location             Location?
  objectives           String?
  targets              String?
  exclusions           String?
  notes                String?
  startPrep            DateTime?
  endPrep              DateTime?
  startRecon           DateTime?
  endRecon             DateTime?
  startTesting         DateTime?
  endTesting           DateTime?
  startReporting       DateTime?
  endReporting         DateTime?
  outbrief             DateTime?
  operators            Operator[]    // Implicit M:N
  contacts             Contact[]     @relation("EngagementContacts")
  trustedAgents        Contact[]     @relation("TrustedAgents")
  findings             Finding[]
  findingContexts      EngagementFindingContext[]
  report               EngagementReport?
  issuedReports        IssuedReport[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([clientId])
  @@index([status])
}

enum EngagementStatus {
  Prep
  Recon
  Testing
  Reporting
  Complete
}

enum EngagementType {
  AI
  Code_Review
  Firewall
  Multi
  Pentest
  Phishing
  Physical
  Purple_Team
  Red_Team
  USB_Drop
  Vishing
  Web_App
  Wireless
}

enum Location {
  Internal
  External
}

model Client {
  id                   String        @id @default(uuid())
  company              String        @map("companyName")
  address              String?
  city                 String?
  state                String?
  zip                  String?
  phone                String?       @map("phoneNumber")
  website              String?
  notes                String?
  contacts             Contact[]
  engagements          Engagement[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model Contact {
  id                   String        @id @default(uuid())
  clientId             String
  client               Client        @relation(fields: [clientId], references: [id])
  name                 String
  title                String?
  email                String?
  phone                String?       @map("phoneNumber")
  notes                String?
  assignedEngagements  Engagement[]  @relation("EngagementContacts")
  trustedEngagements   Engagement[]  @relation("TrustedAgents")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([clientId])
}

model Finding {
  id                   String        @id @default(uuid())
  engagementId         String?
  engagement           Engagement?   @relation(fields: [engagementId], references: [id])
  title                String
  category             String?
  severity             String
  background           String?
  remediation          String?
  supportingData       String?       @map("supportingLinks")
  screenshots          Screenshot[]
  engagementContext    EngagementFindingContext?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  version              Int           @default(1)
  reviewStatus         FindingReviewStatus @default(Draft)
  authorId             String?
  author               User? @relation("FindingAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reviewerId           String?
  reviewer             User? @relation("FindingReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  templateId           String?
  importFingerprint    String?
  revisions            FindingRevision[]
  drafts               FindingDraft[]
  comments             FindingComment[]

  @@index([engagementId])
  @@index([reviewStatus])
  @@index([authorId])
  @@index([reviewerId])
  @@unique([engagementId, importFingerprint])
}

model EngagementFindingContext {
  id             String     @id @default(uuid())
  engagementId   String
  findingId      String     @unique
  engagement     Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  finding        Finding    @relation(fields: [findingId], references: [id], onDelete: Cascade)
  observation    String?
  affectedHosts  String?    @map("affected_hosts")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([engagementId, findingId])
  @@index([engagementId])
}

model Screenshot {
  id                   String        @id @default(uuid())
  findingId            String   
  finding              Finding       @relation(fields: [findingId], references: [id])
  filePath             String
  description          String?
  createdAt            DateTime      @default(now())
  sortOrder            Int           @default(0)

  @@index([findingId])
  @@index([filePath])
}

enum FindingReviewStatus {
  Draft
  Ready
  ChangesRequested
  Approved
}

model FindingTemplate {
  id        String @id @default(uuid())
  title     String
  category  String
  severity  String
  content   Json
  approved  Boolean @default(false)
  version   Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FindingRevision {
  id        String @id @default(uuid())
  findingId String
  finding   Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  version   Int
  content   Json
  actorId   String
  reason    String
  createdAt DateTime @default(now())
  @@unique([findingId, version])
}

model FindingDraft {
  id          String @id @default(uuid())
  findingId   String
  finding     Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseVersion Int
  version     Int @default(1)
  content     Json
  updatedAt   DateTime @updatedAt
  @@unique([findingId, userId])
  @@index([userId])
}

model FindingComment {
  id        String @id @default(uuid())
  findingId String
  finding   Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  actorId   String
  username  String
  body      String
  createdAt DateTime @default(now())
  @@index([findingId, createdAt])
}

model EngagementReport {
  engagementId     String @id
  engagement       Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  title            String
  executiveSummary String @default("")
  findingIds       String[]
  version          Int @default(1)
  updatedAt        DateTime @updatedAt
}

model IssuedReport {
  id           String @id @default(uuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  version      Int
  title        String
  issuedBy     String
  snapshot     Json
  pdf          Bytes
  sha256       String
  createdAt    DateTime @default(now())
  @@unique([engagementId, version])
}

model Operator {
  id                   String        @id @default(uuid())
  name                 String
  title                String?
  email                String?
  phoneNumber          String?
  discord              String?
  github               String?
  notes                String?
  engagements          Engagement[]  // Implicit M:N
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}
